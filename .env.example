# Chain Dials (optional)

# Public origin for OG cards + X share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://chaindials.com

# Support inbox (Privacy / Terms / store listings)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@chaindials.com

# Native Capacitor shells load this URL (production App Store / Play builds)
CAP_SERVER_URL=https://chaindials.com

# Dev-only: live-reload WebView against local Next (iOS simulator → localhost,
# Android emulator → 10.0.2.2, physical device → your LAN IP)
# CAP_DEV_URL=http://192.168.1.10:3000

# CoinGecko is optional (gap-fill only). Spot + history prefer Coinbase public APIs.
# COINGECKO_DEMO_API_KEY=
# COINGECKO_API_KEY=

# Lightning tip jar (LNURL, Lightning Address, or invoice).
# Leave unset to hide the tip control entirely.
# NEXT_PUBLIC_LN_ADDRESS=you@getalby.com

# Partner / affiliate slot
NEXT_PUBLIC_PARTNER_NAME=Trezor
NEXT_PUBLIC_PARTNER_URL=https://trezor.io/
NEXT_PUBLIC_PARTNER_BLURB=Keys on a device you hold — so custody stays yours.

# Auth.js (required for accounts)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# CargoBase: accounts, Pro entitlement, and all saved data (required for accounts)
CARGOBASE_URL=
CARGOBASE_ANON_KEY=
# Server-only. Bypasses row-level security; used by the Stripe webhook.
CARGOBASE_SERVICE_ROLE_KEY=

# Stripe Billing. Create a Product + recurring Price in Stripe Dashboard.
# The Price amount must match PRO_PRICE_USD in src/lib/pro.ts ($3/mo), which the UI shows.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Forward webhooks locally: stripe listen --forward-to localhost:3000/api/billing/webhook

# Force Pro UI chrome without Stripe (client demo only; does not unlock APIs)
# NEXT_PUBLIC_PRO_FORCE=true
# Force Pro on server gates outside production (never set in prod)
# PRO_FORCE=true
