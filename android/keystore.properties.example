# Copy to android/keystore.properties (gitignored) and fill in real values.
# Generate a upload keystore once:
#   keytool -genkey -v -keystore chaindials-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias chaindials
#
# storeFile can be absolute or relative to the android/ module.

storeFile=../chaindials-upload.jks
storePassword=REPLACE_ME
keyAlias=chaindials
keyPassword=REPLACE_ME
