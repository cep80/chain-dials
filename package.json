{
  "name": "btc-dash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "cap:sync": "npx cap sync",
    "cap:assets": "npx capacitor-assets generate --iconBackgroundColor '#0a0c10' --iconBackgroundColorDark '#0a0c10' --splashBackgroundColor '#0a0c10' --splashBackgroundColorDark '#0a0c10'",
    "cap:prod": "cross-env CAP_ENV=production CAP_SERVER_URL=https://chaindials.com npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "ios:dev": "cross-env CAP_DEV_URL=http://localhost:3000 npx cap sync ios && npx cap open ios",
    "android:dev": "cross-env CAP_DEV_URL=http://10.0.2.2:3000 npx cap sync android && npx cap open android",
    "ios:prod": "cross-env CAP_ENV=production CAP_SERVER_URL=https://chaindials.com npx cap sync ios && npx cap open ios",
    "android:prod": "cross-env CAP_ENV=production CAP_SERVER_URL=https://chaindials.com npx cap sync android && npx cap open android",
    "mobile:sync": "npx cap sync",
    "android:bundle": "cd android && .\\gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "nostr-tools": "^2.24.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
